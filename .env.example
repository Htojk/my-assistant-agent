# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
#
# 说明：本机 prac/ 目录下的既有配置用的是 OpenAI 兼容端点，
# 因此这里默认按同样的方式接入。用官方 OpenAI / Anthropic 时只填 API key 即可。

# --- 模型 ---
# 形如 provider:model。provider 需与 langchain 的 provider 包对应。
MAA_MODEL=openai:gpt-5.5
# MAA_MODEL=anthropic:claude-sonnet-5

# --- OpenAI 兼容端点（用官方 OpenAI 时删掉 BASE_URL 即可）---
OPENAI_BASE_URL=https://your-endpoint.example.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- Anthropic（用 claude 时填）---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- 可选：LangSmith 追踪 ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_PROJECT=my-assistant-agent
